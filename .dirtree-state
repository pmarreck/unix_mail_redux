# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	bin/post = LuaJIT human/agent mail CLI entry point
	flake.nix = Pinned LuaJIT/Himalaya development environment and future package/module outputs
	nix/module.nix = Reusable NixOS module for tailnet-only Postfix, Dovecot, credentials, TLS, and Maildir
	nix/package.nix = Nix derivation for the packaged post CLI and its LuaJIT runtime
	src/app.lua = Pure command planner and project/mailbox context resolver for the post CLI
	src/args.lua = Pure order-independent parser for the post CLI
	src/identity.lua = Pure project identity validation, collision classification, and mail address/folder derivation
	src/process.lua = Shell-free luv process adapter for invoking the Himalaya transport
	src/transport.lua = Shell-free Himalaya argv construction
	src/wake.lua = Pure conservative agent wake-decision state machine
	tests = Unit and CLI contract tests
	tests/fixtures/fake_himalaya = Deterministic Himalaya stand-in used by CLI integration tests
	tests/fixtures/process_echo = Deterministic stdin echo fixture for process adapter tests
	tests/fixtures/process_large_output = Pipe-buffer-sized output fixture guarding against capture truncation
	tests/integration/process_spec.lua = Integration coverage for stdin streaming and complete asynchronous pipe drainage
	tests/nix/module_eval.nix = Pure NixOS module policy and wiring assertions
	tests/unit/app_spec.lua = Unit coverage for post command planning and repository context inference
]
