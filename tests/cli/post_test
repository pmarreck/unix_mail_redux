#!/usr/bin/env bash

set -u

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source /home/pmarreck/dotfiles/bin/src/capture.bash

failures=0

expect() {
	local description=$1
	local expected_rc=$2
	local expected_out=$3
	local expected_err=$4
	shift 4
	local out err rc
	capture "$@"
	if [[ "$rc" != "$expected_rc" || "$out" != "$expected_out" || "$err" != "$expected_err" ]]; then
		printf 'FAIL %s\n  rc: %q\n  out: %q\n  err: %q\n' \
			"$description" "$rc" "$out" "$err" >&2
		failures=$((failures + 1))
	fi
}

with_input() {
	local input=$1
	shift
	printf '%s' "$input" | "$@"
}

expect "help" 0 \
	"usage: post [options] [list|read ID|reply ID|to PROJECT|status|watch]" \
	"" \
	"$project_root/bin/post" --simple --help

expect "about" 0 \
	"post 0.1.0: project-aware Unix mail for humans and agents (linux x86_64)" \
	"" \
	"$project_root/bin/post" --simple --about

expect "unknown option" 2 "" "post: unknown option: --wat" \
	"$project_root/bin/post" --wat

expected_list_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\n--json\nenvelope\nlist\n--mailbox\nAgents.validate'
expect "JSON project inbox" 0 "$expected_list_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" --json --as validate

expected_read_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\nread\n42\n--mailbox\nAgents.validate\n--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nflag\nadd\n--flag\nseen\n42\n--mailbox\nAgents.validate'
expect "reading marks the message Seen" 0 "$expected_read_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" read 42 --as validate

expected_status_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\n--json\nmailbox\nlist'
expect "JSON fleet status" 0 "$expected_status_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" status --json

expected_send=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\ncompose\n--from\nunix_mail_redux@agents.home.arpa\n--to\nvalidate@agents.home.arpa\n--subject\nBound the scanner\n--save\nSent\n--send\n--BODY--\nPlease reproduce this under a cgroup ceiling.'
expect "confirmed project message" 0 "$expected_send" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n' --yes

expected_review=$'From: unix_mail_redux@agents.home.arpa\nTo: validate@agents.home.arpa\nSubject: Bound the scanner\n\nPlease reproduce this under a cgroup ceiling.\n\nSend? [y/N] '
expect "review and accept project message" 0 "$expected_send" "$expected_review" \
	with_input yes env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n'

expect "review and reject project message" 0 "" "${expected_review}Not sent." \
	with_input no env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n'

reply_candidate=$'From: validate@agents.home.arpa\r\nTo: peter@agents.home.arpa\r\nSubject: Re: Integration delivery\r\nIn-Reply-To: <original@agents.home.arpa>\r\nReferences: <original@agents.home.arpa>\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nThe bounded test now passes.\n'
expected_reply_send=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\nsend\n--save\nSent\n--BODY--\n'"${reply_candidate%$'\n'}"
expected_reply_review=$'From: validate@agents.home.arpa\nTo: peter@agents.home.arpa\nSubject: Re: Integration delivery\n\nThe bounded test now passes.\n\nSend? [y/N] '
expect "review and accept threaded reply" 0 "$expected_reply_send" "$expected_reply_review" \
	with_input yes env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" reply 42 --as validate \
	--body $'The bounded test now passes.\n'

expect "review and reject threaded reply" 0 "" "${expected_reply_review}Not sent." \
	with_input no env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" reply 42 --as validate \
	--body $'The bounded test now passes.\n'

watch_sandbox="$(mktemp -d "${TMPDIR:-/tmp}/post-watch-cli.XXXXXX")"
trap 'rm -rf -- "$watch_sandbox"' EXIT
mkdir -p "$watch_sandbox/mail/.Agents.validate/new"
touch "$watch_sandbox/mail/.Agents.validate/new/mail-1"
: > "$watch_sandbox/tmux.calls"
expect "one-shot delivery watcher" 0 "" \
	"post: 1 unread mail message for validate" \
	env POST_TMUX="$project_root/tests/fixtures/fake_tmux" \
	POST_TMUX_CALLS="$watch_sandbox/tmux.calls" \
	POST_WAKE_PROJECTS=validate \
	"$project_root/bin/post" watch --once \
	--maildir "$watch_sandbox/mail" \
	--state-file "$watch_sandbox/state/watch.json"
watch_calls="$(cat "$watch_sandbox/tmux.calls")"
if [[ $watch_calls != *'display-message|-t|validate|--|📬 1 unread mail message for validate|'* ]]; then
	printf 'FAIL watcher omitted the side-band notice\n' >&2
	failures=$((failures + 1))
fi
if [[ $watch_calls != *'send-keys|-t|%1|-l|📬 You have 1 unread mail message for validate.'* ]]; then
	printf 'FAIL watcher omitted the fixed-content wake\n' >&2
	failures=$((failures + 1))
fi
calls_before="$(wc -l < "$watch_sandbox/tmux.calls")"
expect "watcher deduplicates a persisted delivery" 0 "" "" \
	env POST_TMUX="$project_root/tests/fixtures/fake_tmux" \
	POST_TMUX_CALLS="$watch_sandbox/tmux.calls" \
	POST_WAKE_PROJECTS=validate \
	"$project_root/bin/post" watch --once \
	--maildir "$watch_sandbox/mail" \
	--state-file "$watch_sandbox/state/watch.json"
if [[ $(wc -l < "$watch_sandbox/tmux.calls") != "$calls_before" ]]; then
	printf 'FAIL duplicate delivery reached tmux\n' >&2
	failures=$((failures + 1))
fi

if (( failures > 0 )); then
	exit "$failures"
fi

printf 'PASS post CLI\n'
