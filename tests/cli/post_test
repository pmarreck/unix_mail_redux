#!/usr/bin/env bash

set -u

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source /home/pmarreck/dotfiles/bin/src/capture.bash

failures=0

expect() {
	local description=$1
	local expected_rc=$2
	local expected_out=$3
	local expected_err=$4
	shift 4
	local out err rc
	capture "$@"
	if [[ "$rc" != "$expected_rc" || "$out" != "$expected_out" || "$err" != "$expected_err" ]]; then
		printf 'FAIL %s\n  rc: %q\n  out: %q\n  err: %q\n' \
			"$description" "$rc" "$out" "$err" >&2
		failures=$((failures + 1))
	fi
}

with_input() {
	local input=$1
	shift
	printf '%s' "$input" | "$@"
}

expect "help" 0 \
	"usage: post [options] [list|read ID|reply ID|to PROJECT|status|watch]" \
	"" \
	"$project_root/bin/post" --simple --help

expect "about" 0 \
	"post 0.1.0: project-aware Unix mail for humans and agents (linux x86_64)" \
	"" \
	"$project_root/bin/post" --simple --about

expect "unknown option" 2 "" "post: unknown option: --wat" \
	"$project_root/bin/post" --wat

expected_list_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\n--json\nenvelope\nlist\n--mailbox\nAgents/validate'
expect "JSON project inbox" 0 "$expected_list_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" --json --as validate

expected_status_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\n--json\nmailbox\nlist'
expect "JSON fleet status" 0 "$expected_status_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" status --json

expected_send=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\ncompose\n--from\nunix_mail_redux@agents.home.arpa\n--to\nvalidate@agents.home.arpa\n--subject\nBound the scanner\n--save\nSent\n--send\n--BODY--\nPlease reproduce this under a cgroup ceiling.'
expect "confirmed project message" 0 "$expected_send" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n' --yes

expected_review=$'From: unix_mail_redux@agents.home.arpa\nTo: validate@agents.home.arpa\nSubject: Bound the scanner\n\nPlease reproduce this under a cgroup ceiling.\n\nSend? [y/N] '
expect "review and accept project message" 0 "$expected_send" "$expected_review" \
	with_input yes env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n'

expect "review and reject project message" 0 "" "${expected_review}Not sent." \
	with_input no env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n'

if (( failures > 0 )); then
	exit "$failures"
fi

printf 'PASS post CLI\n'
