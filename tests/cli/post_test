#!/usr/bin/env bash

set -u

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source /home/pmarreck/dotfiles/bin/src/capture.bash

failures=0

expect() {
	local description=$1
	local expected_rc=$2
	local expected_out=$3
	local expected_err=$4
	shift 4
	local out err rc
	capture "$@"
	if [[ "$rc" != "$expected_rc" || "$out" != "$expected_out" || "$err" != "$expected_err" ]]; then
		printf 'FAIL %s\n  rc: %q\n  out: %q\n  err: %q\n' \
			"$description" "$rc" "$out" "$err" >&2
		failures=$((failures + 1))
	fi
}

with_input() {
	local input=$1
	shift
	printf '%s' "$input" | "$@"
}

expect "help" 0 \
	$'usage: post [options] [list|read ID|reply ID|to PROJECT|status|watch|smime ACTION]\n  --attachment PATH  Attach a file to to/reply; repeat for multiple files.\n                     Also accepts --attachment=PATH. Listed in send review.\n                     Use - or @stdin once with --body; --yes for piped sends.' \
	"" \
	"$project_root/bin/post" --simple --help

expect "about" 0 \
	"post 0.1.0: project-aware Unix mail for humans and agents (linux x86_64)" \
	"" \
	"$project_root/bin/post" --simple --about

expect "unknown option" 2 "" "post: unknown option: --wat" \
	"$project_root/bin/post" --wat

expect "missing attachment refuses send" 2 "" \
	"post: attachment is not a readable regular file: /nonexistent/post-attachment" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to peter --as einstein --subject test --body test \
	--attachment /nonexistent/post-attachment --yes

smime_sandbox="$(mktemp -d "${TMPDIR:-/tmp}/post-smime-cli.XXXXXX")"
printf '%s\n' 'root passphrase with enough entropy' > "$smime_sandbox/root-passphrase"
printf '%s\n' 'phone passphrase with enough entropy' > "$smime_sandbox/phone-passphrase"
ca_directory="$smime_sandbox/offline ca"
identity_directory="$smime_sandbox/peter iphone"
expected_ca_output="Created S/MIME root CA.
Private key: $ca_directory/root-ca-key.pem
Certificate: $ca_directory/root-ca.pem
Apple certificate: $ca_directory/root-ca.cer
Keep the private key offline."
expect "create offline S/MIME root" 0 "$expected_ca_output" "" \
	"$project_root/bin/post" --simple smime init-ca \
	--out "$ca_directory" --passphrase-file "$smime_sandbox/root-passphrase"

expected_identity_output="Created S/MIME identity for peter@agents.home.arpa.
PKCS#12: $identity_directory/identity.p12
Certificate: $identity_directory/identity.pem"
expect "issue Apple Mail S/MIME identity" 0 "$expected_identity_output" "" \
	"$project_root/bin/post" --simple smime issue \
	--ca "$ca_directory" --out "$identity_directory" \
	--email peter@agents.home.arpa --name "Peter iPhone" \
	--ca-passphrase-file "$smime_sandbox/root-passphrase" \
	--identity-passphrase-file "$smime_sandbox/phone-passphrase"

expect "refuse to replace an S/MIME identity" 2 "" \
	"post: refusing to replace existing output directory: $identity_directory" \
	"$project_root/bin/post" --simple smime issue \
	--ca "$ca_directory" --out "$identity_directory" \
	--email peter@agents.home.arpa --name "Peter iPhone" \
	--ca-passphrase-file "$smime_sandbox/root-passphrase" \
	--identity-passphrase-file "$smime_sandbox/phone-passphrase"

printf '%s\n' 'approved signed instruction' > "$smime_sandbox/instruction.txt"
printf '%s\n' 'phone passphrase with enough entropy' | \
	"$POST_OPENSSL" pkcs12 -in "$identity_directory/identity.p12" \
	-passin stdin -nocerts -nodes -out "$smime_sandbox/identity-key.pem" \
	2> "$smime_sandbox/pkcs12-extract.log"
if (( $? != 0 )); then
	printf 'FAIL extract test S/MIME identity\n' >&2
	failures=$((failures + 1))
fi
"$POST_OPENSSL" cms -sign -in "$smime_sandbox/instruction.txt" \
	-signer "$identity_directory/identity.pem" \
	-inkey "$smime_sandbox/identity-key.pem" \
	-out "$smime_sandbox/signed.eml" -outform SMIME -md sha256 -text \
	2> "$smime_sandbox/smime-sign.log"
if (( $? != 0 )); then
	printf 'FAIL independently sign test S/MIME message\n' >&2
	failures=$((failures + 1))
fi
declare out err rc
capture "$project_root/bin/post" --simple smime verify \
	--input "$smime_sandbox/signed.eml" \
	--ca-cert "$ca_directory/root-ca.pem" \
	--email peter@agents.home.arpa \
	--replay-dir "$smime_sandbox/replays"
verification_prefix=$'Verified S/MIME signer: peter@agents.home.arpa\nReplay key: sha256:'
replay_digest="${err#"$verification_prefix"}"
if [[ $rc != 0 || $out != *'approved signed instruction'* \
	|| $err == "$replay_digest" || ! $replay_digest =~ ^[0-9a-f]{64}$ ]]
then
	printf 'FAIL verify signed S/MIME message\n  rc: %q\n  out: %q\n  err: %q\n' \
		"$rc" "$out" "$err" >&2
	failures=$((failures + 1))
fi
replay_key="sha256:$replay_digest"
expect "refuse replayed S/MIME message" 2 "" \
	"post: replayed S/MIME signature: $replay_key" \
	"$project_root/bin/post" --simple smime verify \
	--input "$smime_sandbox/signed.eml" \
	--ca-cert "$ca_directory/root-ca.pem" \
	--email peter@agents.home.arpa \
	--replay-dir "$smime_sandbox/replays"

expected_list_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\n--json\nenvelope\nlist\n--mailbox\nAgents.validate'
expect "JSON project inbox" 0 "$expected_list_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" --json --as validate

expected_read_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\nread\n42\n--mailbox\nAgents.validate\n--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nflag\nadd\n--flag\nseen\n42\n--mailbox\nAgents.validate'
expect "reading marks the message Seen" 0 "$expected_read_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" read 42 --as validate

expected_status_args=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\n--json\nmailbox\nlist'
expect "JSON fleet status" 0 "$expected_status_args" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" status --json

expected_send=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\ncompose\n--from\nunix_mail_redux@agents.home.arpa\n--to\nvalidate@agents.home.arpa\n--subject\nBound the scanner\n--save\nSent\n--send\n--BODY--\nPlease reproduce this under a cgroup ceiling.'
attachment_send=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\ncompose\n--from\neinstein@agents.home.arpa\n--to\npeter@agents.home.arpa\n--subject\nReview\n--save\nSent\n--send\n--attach\n'"$project_root/README.md"$'\n--attach\n'"$project_root/INTENT.md"$'\n--BODY--\nPlease review.'
attachment_review=$'From: einstein@agents.home.arpa\nTo: peter@agents.home.arpa\nSubject: Review\nAttachment: README.md\nAttachment: INTENT.md\n\nPlease review.\nSend? [y/N] '
expect "repeatable attachments with approval" 0 "$attachment_send" "$attachment_review" \
	with_input yes env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to peter --as einstein --subject Review --body 'Please review.' \
	--attachment README.md --attachment=INTENT.md
expect "declined attachments do not send" 0 "" "${attachment_review}Not sent." \
	with_input no env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to peter --as einstein --subject Review --body 'Please review.' \
	--attachment README.md --attachment=INTENT.md
expect "confirmed project message" 0 "$expected_send" "" \
	env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n' --yes

expected_review=$'From: unix_mail_redux@agents.home.arpa\nTo: validate@agents.home.arpa\nSubject: Bound the scanner\n\nPlease reproduce this under a cgroup ceiling.\n\nSend? [y/N] '
expect "review and accept project message" 0 "$expected_send" "$expected_review" \
	with_input yes env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n'

expect "review and reject project message" 0 "" "${expected_review}Not sent." \
	with_input no env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" to validate --as unix_mail_redux \
	--subject "Bound the scanner" \
	--body $'Please reproduce this under a cgroup ceiling.\n'

reply_candidate=$'From: validate@agents.home.arpa\r\nTo: peter@agents.home.arpa\r\nSubject: Re: Integration delivery\r\nIn-Reply-To: <original@agents.home.arpa>\r\nReferences: <original@agents.home.arpa>\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nThe bounded test now passes.\n'
expected_reply_send=$'--config\n/etc/unix-mail-redux/himalaya.toml\n--account\nunix_mail_redux\nmessage\nsend\n--save\nSent\n--BODY--\n'"${reply_candidate%$'\n'}"
expected_reply_review=$'From: validate@agents.home.arpa\nTo: peter@agents.home.arpa\nSubject: Re: Integration delivery\n\nThe bounded test now passes.\n\nSend? [y/N] '
expect "review and accept threaded reply" 0 "$expected_reply_send" "$expected_reply_review" \
	with_input yes env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" reply 42 --as validate \
	--body $'The bounded test now passes.\n'

expect "review and reject threaded reply" 0 "" "${expected_reply_review}Not sent." \
	with_input no env POST_HIMALAYA="$project_root/tests/fixtures/fake_himalaya" \
	"$project_root/bin/post" reply 42 --as validate \
	--body $'The bounded test now passes.\n'

watch_sandbox="$(mktemp -d "${TMPDIR:-/tmp}/post-watch-cli.XXXXXX")"
trap 'rm -rf -- "$watch_sandbox" "$smime_sandbox"' EXIT
mkdir -p "$watch_sandbox/mail/.Agents.validate/new"
touch "$watch_sandbox/mail/.Agents.validate/new/mail-1"
mkdir -p "$watch_sandbox/project"
: > "$watch_sandbox/herdr.calls"
watch_cli() {
	"$project_root/bin/post" "$@" 2> "$watch_sandbox/stderr"
	local status=$?
	# The private atomic-write suffix is intentionally nondeterministic.
	sed -E 's/mail-validate-[A-Za-z0-9]+\.frontmatter\.md/mail-validate.frontmatter.md/' "$watch_sandbox/stderr" >&2
	return "$status"
}
export -f watch_cli
export project_root watch_sandbox
expect "one-shot delivery watcher" 0 "" \
	"post: mail notice delivered for validate: $watch_sandbox/project/inbox/$(date +%Y-%m-%d)-from-post-watch-mail-validate.frontmatter.md
post: Herdr notified: validate (1 unread)" \
	env POST_HERDR="$project_root/tests/fixtures/fake_herdr" \
	POST_HERDR_CALLS="$watch_sandbox/herdr.calls" POST_TEST_PROJECT="$watch_sandbox/project" \
	POST_WAKE_PROJECTS=validate \
	bash -c 'watch_cli "$@"' -- watch --once \
	--maildir "$watch_sandbox/mail" \
	--state-file "$watch_sandbox/state/watch.json"
watch_calls="$(cat "$watch_sandbox/herdr.calls")"
if [[ $watch_calls != *'notification|show|Mail: validate|--body|1 unread messages. Run post list --as validate|--sound|none|'* ]]; then
	printf 'FAIL watcher omitted the side-band notice\n' >&2
	failures=$((failures + 1))
fi
notice_count="$(
	set +f
	shopt -s nullglob
	notices=( "$watch_sandbox/project/inbox/"*-from-post-watch-mail-validate-*.frontmatter.md )
	printf '%s' "${#notices[@]}"
)"
if [[ $notice_count != 1 ]]; then
	printf 'FAIL watcher omitted the durable fixed-content notice\n' >&2
	failures=$((failures + 1))
fi
notices_before="$(grep -c '^notification|' "$watch_sandbox/herdr.calls")"
expect "watcher deduplicates a persisted delivery" 0 "" "" \
	env POST_HERDR="$project_root/tests/fixtures/fake_herdr" \
	POST_HERDR_CALLS="$watch_sandbox/herdr.calls" POST_TEST_PROJECT="$watch_sandbox/project" \
	POST_WAKE_PROJECTS=validate \
	bash -c 'watch_cli "$@"' -- watch --once \
	--maildir "$watch_sandbox/mail" \
	--state-file "$watch_sandbox/state/watch.json"
if [[ $(grep -c '^notification|' "$watch_sandbox/herdr.calls") != "$notices_before" ]]; then
	printf 'FAIL duplicate delivery repeated the Herdr notification\n' >&2
	failures=$((failures + 1))
fi

if (( failures > 0 )); then
	exit "$failures"
fi

printf 'PASS post CLI\n'
