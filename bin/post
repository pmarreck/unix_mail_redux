#!/usr/bin/env luajit

local executable = arg[0]
local script_directory = executable:match("^(.*)/[^/]+$") or "."
package.path = script_directory .. "/../src/?.lua;" .. package.path

local args = require("args")
local app = require("app")
local process = require("process")

local argv = {}
for index = 1, #arg do
	argv[index] = arg[index]
end

local ok, parsed = pcall(args.parse, argv)
if not ok then
	io.stderr:write("post: ", tostring(parsed), "\n")
	os.exit(2)
end

if parsed.verb == "help" then
	io.write("usage: post [options] [list|read ID|reply ID|to PROJECT|status|watch]\n")
	os.exit(0)
end

if parsed.verb == "about" then
	local os_names = { Linux = "linux", OSX = "macos", Windows = "windows" }
	local arch_names = { x64 = "x86_64", arm64 = "aarch64" }
	local os_name = os_names[jit.os] or string.lower(jit.os)
	local arch_name = arch_names[jit.arch] or jit.arch
	io.write("post 0.1.0: project-aware Unix mail for humans and agents (",
		os_name, " ", arch_name, ")\n")
	os.exit(0)
end

local git_root
if not parsed.identity and parsed.verb ~= "status" then
	local git_result = process.run({
		"git", "-C", os.getenv("PWD") or ".", "rev-parse", "--show-toplevel",
	}, { capture = true })
	if git_result.rc == 0 then
		git_root = git_result.stdout:gsub("%s+$", "")
	end
end

local config = {
	executable = os.getenv("POST_HIMALAYA") or "himalaya",
	config = os.getenv("POST_HIMALAYA_CONFIG") or "/etc/unix-mail-redux/himalaya.toml",
	account = os.getenv("POST_ACCOUNT") or "unix_mail_redux",
}

if parsed.verb == "to" and not parsed.body then
	local handle_type = require("luv").guess_handle(0)
	if handle_type ~= "tty" then
		parsed.body = io.stdin:read("*a")
	end
end

local planned_ok, plan = pcall(app.plan, parsed, {
	config = config,
	git_root = git_root,
	domain = os.getenv("POST_DOMAIN") or "agents.home.arpa",
	human_local_part = os.getenv("POST_HUMAN_LOCAL_PART") or "peter",
})
if not planned_ok then
	io.stderr:write("post: ", tostring(plan), "\n")
	os.exit(2)
end

local result = process.run(plan.argv, { stdin = plan.stdin })
os.exit(result.rc)
