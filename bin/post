#!/usr/bin/env luajit

local executable = arg[0]
local script_directory = executable:match("^(.*)/[^/]+$") or "."
package.path = script_directory .. "/../src/?.lua;" .. package.path

local args = require("args")
local app = require("app")
local process = require("process")
local review = require("review")
local watch_runtime = require("watch_runtime")

local argv = {}
for index = 1, #arg do
	argv[index] = arg[index]
end

local ok, parsed = pcall(args.parse, argv)
if not ok then
	io.stderr:write("post: ", tostring(parsed), "\n")
	os.exit(2)
end

if parsed.verb == "help" then
	io.write("usage: post [options] [list|read ID|reply ID|to PROJECT|status|watch|smime ACTION]\n")
	os.exit(0)
end

if parsed.verb == "about" then
	local os_names = { Linux = "linux", OSX = "macos", Windows = "windows" }
	local arch_names = { x64 = "x86_64", arm64 = "aarch64" }
	local os_name = os_names[jit.os] or string.lower(jit.os)
	local arch_name = arch_names[jit.arch] or jit.arch
	io.write("post 0.1.0: project-aware Unix mail for humans and agents (",
		os_name, " ", arch_name, ")\n")
	os.exit(0)
end

if parsed.verb == "smime" then
	local ceremony = require("smime_ceremony")
	local crypto = require("openssl_crypto")
	local files = require("secure_files")
	local succeeded
	local result
	if parsed.action == "verify" then
		local state_home = os.getenv("XDG_STATE_HOME")
			or ((os.getenv("HOME") or ".") .. "/.local/state")
		parsed.replay_directory = parsed.replay_directory
			or (state_home .. "/unix-mail-redux/smime-replays")
		succeeded, result = pcall(require("smime_verification").verify, parsed, {
			crypto = crypto,
			read_file = files.read_file,
			read_input = files.read_input,
			claim = require("smime_replay").claim,
			now = os.time,
		})
	else
		local operation = parsed.action == "init-ca"
			and ceremony.init_ca or ceremony.issue
		succeeded, result = pcall(operation, parsed, {
			crypto = crypto,
			read_file = files.read_file,
			read_secret = files.read_secret,
			create_directory = files.create_directory,
			now = os.time,
		})
	end
	if not succeeded then
		io.stderr:write("post: ", tostring(result), "\n")
		os.exit(2)
	end
	if parsed.format == "json" then
		io.write(require("cjson").encode(result), "\n")
	elseif result.content then
		io.write(result.content)
		io.stderr:write("Verified S/MIME signer: ", result.signer_email, "\n",
			"Replay key: ", result.replay_key, "\n")
	elseif result.kind == "ca" then
		io.write("Created S/MIME root CA.\n",
			"Private key: ", result.private_key, "\n",
			"Certificate: ", result.certificate, "\n",
			"Apple certificate: ", result.apple_certificate, "\n",
			"Keep the private key offline.\n")
	else
		io.write("Created S/MIME identity for ", result.email, ".\n",
			"PKCS#12: ", result.pkcs12, "\n",
			"Certificate: ", result.certificate, "\n")
	end
	os.exit(0)
end

if parsed.verb == "watch" then
	local maildir = parsed.maildir or os.getenv("POST_MAILDIR")
	if not maildir or maildir == "" then
		io.stderr:write("post: watch requires --maildir or POST_MAILDIR\n")
		os.exit(2)
	end
	local state_file = parsed.state_file or os.getenv("POST_WATCH_STATE")
	if not state_file or state_file == "" then
		local state_home = os.getenv("XDG_STATE_HOME")
			or ((os.getenv("HOME") or ".") .. "/.local/state")
		state_file = state_home .. "/unix-mail-redux/watch.json"
	end

	local function positive_number(value, name, fallback)
		if value == nil or value == "" then return fallback end
		local number = tonumber(value)
		if not number or number <= 0 then
			io.stderr:write("post: ", name, " must be a positive number\n")
			os.exit(2)
		end
		return number
	end

	local authorized = watch_runtime.parse_authorized(os.getenv("POST_WAKE_PROJECTS") or "")
	if parsed.wake == false then
		authorized = {}
	end
	local watch_config = {
		maildir = maildir,
		state_file = state_file,
		tmux = os.getenv("POST_TMUX") or "tmux",
		wake_client = os.getenv("POST_TMUX_WAKE") or "post-tmux-wake",
		authorized = authorized,
		cooldown = positive_number(
			os.getenv("POST_WAKE_COOLDOWN_SECONDS"),
			"POST_WAKE_COOLDOWN_SECONDS",
			60
		),
		notice_retry = positive_number(
			os.getenv("POST_NOTICE_RETRY_SECONDS"),
			"POST_NOTICE_RETRY_SECONDS",
			300
		),
	}
	local interval = parsed.interval or positive_number(
		os.getenv("POST_WATCH_INTERVAL_SECONDS"),
		"POST_WATCH_INTERVAL_SECONDS",
		2
	)

	while true do
		local watched, watch_error = pcall(watch_runtime.run_once, watch_config)
		if not watched then
			io.stderr:write("post: ", tostring(watch_error), "\n")
			os.exit(1)
		end
		if parsed.once then
			os.exit(0)
		end
		require("luv").sleep(math.floor(interval * 1000))
	end
end

local git_root
if not parsed.identity and parsed.verb ~= "status" then
	local git_result = process.run({
		"git", "-C", os.getenv("PWD") or ".", "rev-parse", "--show-toplevel",
	}, { capture = true })
	if git_result.rc == 0 then
		git_root = git_result.stdout:gsub("%s+$", "")
	end
end

local config = {
	executable = os.getenv("POST_HIMALAYA") or "himalaya",
	config = os.getenv("POST_HIMALAYA_CONFIG") or "/etc/unix-mail-redux/himalaya.toml",
	account = os.getenv("POST_ACCOUNT") or "unix_mail_redux",
}

if (parsed.verb == "to" or parsed.verb == "reply") and not parsed.body then
	local handle_type = require("luv").guess_handle(0)
	if handle_type ~= "tty" then
		parsed.body = io.stdin:read("*a")
	end
end

local planned_ok, plan = pcall(app.plan, parsed, {
	config = config,
	git_root = git_root,
	domain = os.getenv("POST_DOMAIN") or "agents.home.arpa",
	human_local_part = os.getenv("POST_HUMAN_LOCAL_PART") or "peter",
})
if not planned_ok then
	io.stderr:write("post: ", tostring(plan), "\n")
	os.exit(2)
end

if parsed.verb == "reply" then
	local prepared = process.run(plan.argv, {
		stdin = plan.stdin,
		capture = true,
	})
	if prepared.stderr ~= "" then
		io.stderr:write(prepared.stderr)
	end
	if prepared.rc ~= 0 then
		os.exit(prepared.rc)
	end

	local preview_ok, preview = pcall(review.from_mime, prepared.stdout, plan.body)
	if not preview_ok then
		io.stderr:write("post: ", tostring(preview), "\n")
		os.exit(2)
	end

	if parsed.confirm ~= false then
		io.stderr:write(review.render(preview), "Send? [y/N] ")
		if not review.confirmed(io.stdin:read("*l")) then
			io.stderr:write("Not sent.\n")
			os.exit(0)
		end
	end

	local sent = process.run(plan.send_argv, { stdin = prepared.stdout })
	os.exit(sent.rc)
end

if parsed.verb == "to" and parsed.confirm ~= false then
	io.stderr:write(review.render(plan), "Send? [y/N] ")
	if not review.confirmed(io.stdin:read("*l")) then
		io.stderr:write("Not sent.\n")
		os.exit(0)
	end
end

local result = process.run(plan.argv, { stdin = plan.stdin })
if result.rc ~= 0 then
	os.exit(result.rc)
end
if plan.after_argv then
	result = process.run(plan.after_argv)
end
os.exit(result.rc)
